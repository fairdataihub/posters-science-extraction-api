# Required for job worker (DB + Bunny storage)
STAGING_DATABASE_URL=
PRODUCTION_DATABASE_URL=
BUNNY_PRIVATE_STORAGE=
BUNNY_PRIVATE_STORAGE_KEY=

# Optional
BUNNY_PUBLIC_STORAGE=
BUNNY_PUBLIC_STORAGE_KEY=
POLL_INTERVAL_SECONDS=30
# Minutes after which a job in 'processing' is marked failed (default 5)
STUCK_PROCESSING_MINUTES=5

# Shared worker: single posters per reserved bulk poster when both have work.
SINGLE_JOBS_PER_BULK=3
# Comma separated registered features. Flags affect new feature entry points.
# Accepted jobs always drain. Use none to explicitly disable all flags.
# Match the posters-science NUXT_FEATURES setting when configuring.
STAGING_FEATURES=bulk_extraction
PRODUCTION_FEATURES=

# Batch completion emails are on when both RESEND_API_KEY and NUXT_SITE_URL are
# set. NUXT_SITE_URL is the website the dashboard link points to; use the
# website's NUXT_SITE_URL. It is shared by every database this worker serves.
# Without either value the worker skips the emails and leaves batches unmarked,
# so they send once both are configured.
RESEND_API_KEY=
# Defaults to Posters.science <noreply@posters.science>. With a personal Resend
# key, use onboarding@resend.dev (delivers only to that account's own email).
RESEND_FROM_ADDRESS=
NUXT_SITE_URL=
