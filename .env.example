# Required for job worker (DB + Bunny storage)
STAGING_DATABASE_URL=
PRODUCTION_DATABASE_URL=
BUNNY_PRIVATE_STORAGE=
BUNNY_PRIVATE_STORAGE_KEY=

# Optional
BUNNY_PUBLIC_STORAGE=
BUNNY_PUBLIC_STORAGE_KEY=
POLL_INTERVAL_SECONDS=30
# Minutes after which a job in 'processing' is marked failed (default 5)
STUCK_PROCESSING_MINUTES=5

# Local 8GB GPU dev: keep false so GET /health does not load Llama into VRAM (default in docker-compose.dev.yml).
# Set true only if you need /health to prove the JSON model loads.
# HEALTH_CHECK_LOAD_JSON_MODEL=false

# PyTorch CUDA allocator (helps fragmentation on small GPUs). docker-compose.dev.yml sets expandable_segments:True.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True